{
  "manifest_version": 3,
  "name": "Study Tracker",
  "version": "1.2.0",
  "description": "브라우저 사용 시간을 측정해서 순공 시간을 계산합니다",

  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "https://api.studytracker.cloud/*"
  ],

  "externally_connectable": {
    "matches": ["https://studytracker.cloud/*"]
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Study Tracker"
  }
}